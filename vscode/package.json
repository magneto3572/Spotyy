{
  "name": "spotyy",
  "displayName": "Spotyy",
  "description": "Spotify controls in your status bar, plus see what teammates on your Wi-Fi are listening to and focus together in Focus Rooms.",
  "version": "0.0.8",
  "publisher": "magneto3572",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#121212",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/magneto3572/Spotyy",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/magneto3572/Spotyy/issues"
  },
  "homepage": "https://github.com/magneto3572/Spotyy/tree/main/vscode#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "spotify",
    "music",
    "player",
    "now playing",
    "focus",
    "pomodoro",
    "team",
    "lan"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spotyy.playPause",
        "title": "Play / Pause",
        "category": "Spotyy"
      },
      {
        "command": "spotyy.next",
        "title": "Next Track",
        "category": "Spotyy"
      },
      {
        "command": "spotyy.previous",
        "title": "Previous Track",
        "category": "Spotyy"
      },
      {
        "command": "spotyy.volumeUp",
        "title": "Volume Up",
        "category": "Spotyy"
      },
      {
        "command": "spotyy.volumeDown",
        "title": "Volume Down",
        "category": "Spotyy"
      },
      {
        "command": "spotyy.setVolume",
        "title": "Set Volume…",
        "category": "Spotyy"
      },
      {
        "command": "spotyy.showPeers",
        "title": "Show Listening Nearby",
        "category": "Spotyy"
      },
      {
        "command": "spotyy.toggleGhostMode",
        "title": "Toggle Ghost Mode",
        "category": "Spotyy"
      },
      {
        "command": "spotyy.startFocusRoom",
        "title": "Start Focus Room…",
        "category": "Spotyy"
      },
      {
        "command": "spotyy.leaveFocusRoom",
        "title": "Leave Focus Room",
        "category": "Spotyy"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spotyy",
          "title": "Spotyy",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "spotyy": [
        {
          "type": "webview",
          "id": "spotyy.peers",
          "name": "Listening Nearby"
        }
      ]
    },
    "configuration": {
      "title": "Spotyy",
      "properties": {
        "spotyy.statusBar.maxTrackLength": {
          "type": "number",
          "default": 40,
          "minimum": 10,
          "description": "Maximum number of characters of the track name shown in the status bar."
        },
        "spotyy.statusBar.showVolume": {
          "type": "boolean",
          "default": true,
          "description": "Show the volume control in the status bar."
        }
      }
    },
    "icons": {
      "spotyy-logo": {
        "description": "Spotyy logo",
        "default": {
          "fontPath": "./media/spotyy-icons.woff",
          "fontCharacter": "\\E900"
        }
      },
      "spotyy-prev": {
        "description": "Previous track",
        "default": {
          "fontPath": "./media/spotyy-icons.woff",
          "fontCharacter": "\\E901"
