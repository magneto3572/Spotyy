  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/test/*.test.js\"",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/magneto3572/Spotyy/blob/main/vscode/ --baseImagesUrl https://raw.githubusercontent.com/magneto3572/Spotyy/main/vscode/",
    "publish:vsce": "vsce publish --no-dependencies --baseContentUrl https://github.com/magneto3572/Spotyy/blob/main/vscode/ --baseImagesUrl https://raw.githubusercontent.com/magneto3572/Spotyy/main/vscode/",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "icons": "python3 scripts/gen-icons.py"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.75.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.6.0"
  }
